[org.gnome.shell]
favorite-apps="['app.zen_browser.zen.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Weather.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Music.desktop', 'steam.desktop', "lutris.desktop", 'org.gnome.Settings.desktop']"

[org.gnome.mutter]
check-alive-timeout=60000
attach-modal-dialogs=true
edge-tiling=true
dynamic-workspaces=true
workspaces-only-on-primary=true

[prg.gnome.desktop.background]
picture-uri="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"
picture-uri-dark="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"

[org.gnome.desktop.screensaver]
picture-uri="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"
lock-enabled=true
lock-delay=330

[org.gnome.desktop.interface]
#gtk-theme="Arc-Dark"
gtk-theme="Arc-Lighter"
icon-theme="Papirus"
enable-animations=true
clock-format="24h"
clock-show-seconds=true
clock-show-date=true
show-weekdate=true
cursor-size=32
font-hinting='slight'
font-antialiasing='rgba'
enable-hot-corners=false
show-battery-percentage=true


[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:appmenu'
action-double-click-titlebar='toggle-maximize'
auto-raise=true

[org.gnome.desktop.wm.keybindings]
switch-windows="['<Alt>Tab']"
switch-windows-backward="['<Shift><Alt>Tab']"
switch-applications="['<Super>Tab']"
switch-applications-backward="['<Shift><Super>Tab']"
switch-to-workspace-1="['<Super>1']"
switch-to-workspace-2="['<Super>2']"
switch-to-workspace-3="['<Super>3']"
switch-to-workspace-4="['<Super>4']"
move-to-workspace-1="['<Shift><Super>1']"
move-to-workspace-2="['<Shift><Super>2']"
show-desktop="['<Super>d']"

[org.gnome.SessionManager]
logout-prompt=true

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
natural-scroll=true
send-events='disabled-on-external-mouse'
edge-scrolling-enabled=true
disable-while-typing=true

[org.gnome.desktop.peripherals.touchpad:GNOME-Greeter]
tap-to-click=true

[org.gnome.desktop.peripherals.mouse]
natural-scroll=true
middle-click-emulation=false

[org.gnome.nautilus.preferences]
recursive-search='local-only'
show-image-thumbnails='local-only'
click-policy='double'
default-sort-order='name'

[org.gnome.desktop.privacy]
old-files-age=30
remove-old-trash-files=true
remove-old-temp-files=true
remember-recent-files=true
recent-files-max-age=7

