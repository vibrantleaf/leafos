[org.gnome.mutter]
check-alive-timeout=60000
attach-modal-dialogs=true
edge-tiling=true
dynamic-workspaces=true
workspaces-only-on-primary=true

[prg.gnome.desktop.background]
picture-uri="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"
picture-uri-dark="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"

[org.gnome.desktop.screensaver]
picture-uri="file:///usr/share/backgrounds/bluefin/08-bluefin.xml"
lock-enabled=true
lock-delay=330

[org.gnome.desktop.interface]
#gtk-theme="Arc-Dark"
gtk-theme="Arc-Lighter"
icon-theme="Papirus"
enable-animations=true
clock-format="24h"
clock-show-seconds=true
clock-show-date=true
cursor-size=32
font-hinting='slight'
font-antialiasing='rgba'
enable-hot-corners=false
show-battery-percentage=true

[org.gnome.desktop.calendar]
show-weekdate=true

[org.gnome.desktop.wm.preferences]
button-layout='close,minimize,maximize:appmenu'
action-double-click-titlebar='toggle-maximize'
auto-raise=true

[org.gnome.SessionManager]
logout-prompt=true

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
natural-scroll=true
send-events='disabled-on-external-mouse'
edge-scrolling-enabled=true
disable-while-typing=true

[org.gnome.desktop.peripherals.touchpad:GNOME-Greeter]
tap-to-click=true

[org.gnome.desktop.peripherals.mouse]
natural-scroll=true
middle-click-emulation=false

[org.gnome.nautilus.preferences]
recursive-search='local-only'
show-image-thumbnails='local-only'
click-policy='double'
default-sort-order='name'

[org.gnome.desktop.privacy]
old-files-age=30
remove-old-trash-files=true
remove-old-temp-files=true
remember-recent-files=true
recent-files-max-age=7

